# 密钥使用 AES-256-GCM 加密落盘的根密钥（32 字节随机 hex，64 字符）
# 首次启动若缺失，服务端会自动生成并写回本文件（详见 lib/master-key.ts）
MASTER_KEY=

# 管理后台登录密码（请务必修改）
ADMIN_PASSWORD=change-me-please

# 以下为初始密钥，建议在管理后台 /admin 配置（加密存储）。
# 留空则对应功能降级。
KIMI_API_KEY=
KIMI_BASE_URL=https://api.kimi.com/coding/v1
TRONGRID_API_KEY=

# ── API 订阅计量扣费（Stripe）──
# 真实密钥：Stripe Dashboard → Developers → API keys（sk_test_*/sk_live_*）
# 与 Webhooks（whsec_*，端点 https://你的域名/api/billing/webhook）
# 留空时订阅功能走 mock 模式（本地演示/测试，不发起真实支付）
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# 生产域名（用于构造 Checkout 成功/取消回跳地址）
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ── 外部威胁情报同步 ──
# TRONSCAN 免费 API key（tronscan.org → API 申请）；配置后启用 tronscan 情报源
# 未配置时情报同步走默认的链上启发式源（heuristic-tron，无需 key）
TRONSCAN_API_KEY=
