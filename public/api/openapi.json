{
  "openapi": "3.1.0",
  "info": {
    "title": "ChainSentinel Agent API",
    "version": "1.0.0",
    "summary": "Crypto AML / on-chain risk screening for autonomous AI agents",
    "description": "Screen TRON, BTC and ETH addresses against OFAC SDN sanctions, 900+ blacklist labels and live chain heuristics. No signup for the free tier. Prepaid credits via TRON USDT (TRC20), $0.01 per paid check. Full docs: https://chainsentinel.hk/llms-full.txt",
    "contact": { "name": "ChainSentinel", "url": "https://chainsentinel.hk/agent" },
    "license": { "name": "MIT", "identifier": "MIT" }
  },
  "servers": [{ "url": "https://chainsentinel.hk", "description": "Production" }],
  "tags": [
    { "name": "screening", "description": "Address risk screening" },
    { "name": "billing", "description": "Agent prepaid credits" },
    { "name": "discovery", "description": "Machine-readable discovery" }
  ],
  "x-agent-discovery": {
    "llmsTxt": "/llms.txt",
    "llmsFullTxt": "/llms-full.txt",
    "manifest": "/api/v1/manifest",
    "agentCard": "/.well-known/agent-card.json",
    "mcp": "/api/mcp",
    "docsPage": "/agent"
  },
  "x-agent-pricing": {
    "currency": "USD",
    "pricePerCallUsd": 0.01,
    "freeCallsPerMinutePerIp": 30,
    "paidCallsPerMinute": 300,
    "minTopupUsdt": 1,
    "quoteRequired": true,
    "quoteEndpoint": "/api/v1/quote",
    "quoteTtlSec": 1800,
    "network": "tron",
    "asset": "USDT",
    "contract": "TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t",
    "scheme": "prepaid-onchain-transfer",
    "note": "x402-inspired; not an official x402 facilitator integration"
  },
  "paths": {
    "/api/v1/check": {
      "get": {
        "operationId": "checkUsage",
        "summary": "Usage example for agents that probe a GET first",
        "tags": ["discovery"],
        "responses": { "200": { "description": "Curl example, pricing, docs links", "content": { "application/json": { "schema": { "type": "object" } } } } }
      },
      "post": {
        "operationId": "checkAddress",
        "summary": "Screen one crypto address for AML risk",
        "description": "Free tier needs no credentials (30/min per IP). With a cs_agent_* Bearer credential each successful call costs 0.01 USD. Send X-Request-Id to make billing idempotent.",
        "tags": ["screening"],
        "security": [{}, { "agentBearer": [] }],
        "parameters": [
          { "name": "X-Request-Id", "in": "header", "required": false, "schema": { "type": "string" }, "description": "Idempotency key for paid calls; same id never debits twice." },
          { "name": "X-RateLimit-Remaining", "in": "header", "required": false, "schema": { "type": "integer" }, "description": "Response header: remaining calls in the current minute." },
          { "name": "X-Agent-Balance-Usd", "in": "header", "required": false, "schema": { "type": "number" }, "description": "Response header: remaining prepaid balance (paid calls only)." }
        ],
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckRequest" }, "examples": { "ofac": { "value": { "address": "TNiq9AXBp9EjUqhDhrwrfvAA8U3GUQZH81" } }, "eth": { "value": { "address": "0x0000000000000000000000000000000000000000" } } } } }
        },
        "responses": {
          "200": { "description": "Risk verdict", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckResponse" } } } },
          "400": { "description": "INVALID_JSON / INVALID_ADDRESS / UNSUPPORTED_ADDRESS_FORMAT", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "401": { "description": "INVALID_TOKEN", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "402": { "description": "PAYMENT_REQUIRED — response contains a payment object with address, network, minimum and steps", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "429": { "description": "RATE_LIMITED", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/quote": {
      "post": {
        "operationId": "createQuote",
        "summary": "Get a one-time quoteId and a unique exact USDT amount",
        "description": "REQUIRED before paying. The operator receiving address is public, so a claim keyed only by txId could be stolen by anyone observing incoming transfers. A unique 6-decimal amount binds the transfer to this claim. Quotes expire after 30 minutes.",
        "tags": ["billing"],
        "responses": {
          "200": { "description": "quoteId, amountUsdt, address, expiresAt, ttlSec, next steps", "content": { "application/json": { "schema": { "type": "object" } } } },
          "429": { "description": "RATE_LIMITED", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      },
      "get": { "operationId": "createQuoteGet", "summary": "Same as POST /api/v1/quote", "tags": ["billing"], "responses": { "200": { "description": "Quote", "content": { "application/json": { "schema": { "type": "object" } } } } } }
    },
    "/api/v1/topup": {
      "get": {
        "operationId": "topupInfo",
        "summary": "Payment address, price, minimum and exact steps",
        "tags": ["billing"],
        "responses": { "200": { "description": "Payment instructions", "content": { "application/json": { "schema": { "type": "object" } } } } }
      },
      "post": {
        "operationId": "claimTopup",
        "summary": "Claim prepaid credits with {txId, quoteId}",
        "description": "Verifies the transfer on-chain AND that its amount exactly equals the one-time quoted 6-decimal USDT amount, then mints a Bearer credential. Idempotent per txId. Non-custodial — funds go directly to the operator wallet.",
        "tags": ["billing"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TopupRequest" } } } },
        "responses": {
          "200": { "description": "Credential and balance", "content": { "application/json": { "schema": { "type": "object", "properties": { "ok": { "type": "boolean" }, "credential": { "type": "string" }, "tokenType": { "type": "string" }, "balanceUsd": { "type": "number" }, "estimatedCalls": { "type": "integer" }, "alreadyClaimed": { "type": "boolean" } } } } } },
          "400": { "description": "QUOTE_REQUIRED / QUOTE_INVALID / QUOTE_EXPIRED / QUOTE_TX_MISMATCH / QUOTE_REUSED / INVALID_TXID / TX_NOT_FOUND / TX_UNCONFIRMED / TX_ALREADY_USED / AMOUNT_TOO_SMALL / AMOUNT_MISMATCH / UPSTREAM_UNAVAILABLE", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } },
          "503": { "description": "PAYMENTS_NOT_CONFIGURED — free tier still works", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/balance": {
      "get": {
        "operationId": "getBalance",
        "summary": "Remaining prepaid credits for a cs_agent_* credential",
        "tags": ["billing"],
        "security": [{ "agentBearer": [] }],
        "responses": {
          "200": { "description": "Balance snapshot", "content": { "application/json": { "schema": { "type": "object" } } } },
          "401": { "description": "INVALID_TOKEN", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorResponse" } } } }
        }
      }
    },
    "/api/v1/manifest": {
      "get": {
        "operationId": "getManifest",
        "summary": "Full machine-readable service manifest",
        "tags": ["discovery"],
        "responses": { "200": { "description": "Capabilities, endpoints, pricing, error codes, idempotency", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    },
    "/api/mcp": {
      "get": { "operationId": "mcpInfo", "summary": "Describe the JSON-RPC tools endpoint", "tags": ["discovery"], "responses": { "200": { "description": "Endpoint info", "content": { "application/json": { "schema": { "type": "object" } } } } } },
      "post": {
        "operationId": "mcpRpc",
        "summary": "MCP-style JSON-RPC 2.0 (initialize / tools/list / tools/call / ping)",
        "description": "Tools: check_address, get_balance, topup_info. Stateless: one request per HTTP call, no session id, no SSE.",
        "tags": ["screening", "discovery"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["jsonrpc", "id", "method"], "properties": { "jsonrpc": { "type": "string", "const": "2.0" }, "id": { "type": ["integer", "string", "null"] }, "method": { "type": "string", "enum": ["initialize", "tools/list", "tools/call", "ping"] }, "params": { "type": "object" } } }, "examples": { "list": { "value": { "jsonrpc": "2.0", "id": 1, "method": "tools/list" } }, "call": { "value": { "jsonrpc": "2.0", "id": 2, "method": "tools/call", "params": { "name": "check_address", "arguments": { "address": "TNiq9AXBp9EjUqhDhrwrfvAA8U3GUQZH81" } } } } } } } },
        "responses": { "200": { "description": "JSON-RPC result", "content": { "application/json": { "schema": { "type": "object" } } } }, "202": { "description": "Notification accepted (no id)" } }
      }
    },
    "/api/check": {
      "post": {
        "operationId": "legacyCheck",
        "summary": "Legacy endpoint for human subscribers (cs_live_* daily quotas)",
        "description": "Behaviour unchanged. Agents should use /api/v1/check.",
        "tags": ["screening"],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CheckRequest" } } } },
        "responses": { "200": { "description": "Risk verdict", "content": { "application/json": { "schema": { "type": "object" } } } } }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "agentBearer": { "type": "http", "scheme": "bearer", "bearerFormat": "cs_agent_<hex>", "description": "Prepaid credential from POST /api/v1/topup. Optional — omit for the free tier." }
    },
    "schemas": {
      "CheckRequest": {
        "type": "object",
        "required": ["address"],
        "additionalProperties": false,
        "properties": { "address": { "type": "string", "minLength": 1, "maxLength": 128, "description": "TRON T... (34 chars), BTC 1/3/bc1..., or ETH 0x... (42 chars)", "examples": ["TNiq9AXBp9EjUqhDhrwrfvAA8U3GUQZH81"] } }
      },
      "CheckResponse": {
        "type": "object",
        "required": ["chain", "level", "score", "reasons", "meta"],
        "properties": {
          "chain": { "type": "string", "enum": ["tron", "btc", "eth"] },
          "level": { "type": "string", "enum": ["red", "yellow", "green"], "description": "red = stop all dealings; lower score = riskier" },
          "score": { "type": "number", "minimum": 0, "maximum": 100 },
          "reasons": { "type": "array", "items": { "type": "string" } },
          "evidenceLinks": { "type": "array", "items": { "type": "string", "format": "uri" } },
          "blacklist": { "type": ["object", "null"], "properties": { "label": { "type": "string" }, "source": { "type": "string" }, "sourceLabel": { "type": "string" } } },
          "stats": { "type": ["object", "null"] },
          "upstreamReachable": { "type": "boolean" },
          "meta": { "type": "object", "properties": { "ok": { "type": "boolean" }, "requestId": { "type": "string" }, "tier": { "type": "string", "enum": ["free", "prepaid"] }, "billedUsd": { "type": "number" }, "pricePerCallUsd": { "type": "number" }, "balanceUsd": { "type": "number" }, "freeCallsRemainingPerMinute": { "type": ["integer", "null"] }, "docs": { "type": "string" } } }
        }
      },
      "TopupRequest": {
        "type": "object",
        "required": ["txId", "quoteId"],
        "additionalProperties": false,
        "properties": {
          "txId": { "type": "string", "description": "64-hex TRON transaction hash of the TRC20 USDT transfer" },
          "quoteId": { "type": "string", "description": "One-time quoteId from POST /api/v1/quote; the on-chain transfer amount must equal the quoted 6-decimal amountUsdt" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["ok", "error"],
        "properties": {
          "ok": { "type": "boolean", "const": false },
          "error": { "type": "object", "required": ["code", "message"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "hint": { "type": "string" }, "retryAfterSec": { "type": "integer" } } },
          "payment": { "type": "object", "description": "Present on 402 / 429: address, network, asset, minTopupUsdt, pricePerCallUsd, steps[]" },
          "docs": { "type": "string" }
        }
      }
    }
  }
}
